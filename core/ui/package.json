{
  "name": "@lamtools/ui",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25",
    "npm": ">=11.17.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/lamtools-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lamtools-ui.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/lamtools-ui.css",
    "./styles.css": "./dist/lamtools-ui.css",
    "./helpers": {
      "import": "./dist/lamtools-ui.js",
      "types": "./dist/helpers/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -b && vue-tsc --noEmit -p tsconfig.demo.json",
    "build:app": "vite build --config vite.config.core-app.ts",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.demo.json && vue-tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test:contract": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.41.0",
    "@vue-flow/minimap": "^1.5.2",
    "dompurify": "^3.4.11",
    "gsap": "^3.15.0",
    "katex": "^0.17.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
