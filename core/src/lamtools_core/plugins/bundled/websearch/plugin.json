{
  "id": "websearch",
  "name": "websearch",
  "version": "0.1.0",
  "description": "网页搜索（内置插件：web_search；配置从 core 设置层迁入插件配置）",
  "tools": ["./tools/tools.jsonc"],
  "operations": ["./operations.jsonc"],
  "configSchema": "./config/schema.jsonc",
  "ui": {
    "sidebar": {
      "widgets": [
        {
          "id": "websearch.engine",
          "title": "Web Search",
          "icon": "search",
          "order": 200,
          "scope": "workspace",
          "renderer": "blocks",
          "snapshotOperation": "websearch.widget.snapshot",
          "actions": [
            {
              "id": "test",
              "title": "Test engine",
              "operation": "websearch.widget.health",
              "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query": {"type": "string", "minLength": 1, "maxLength": 200}
                }
              }
            }
          ]
        }
      ]
    }
  },
  "defaultEnabled": false,
  "builtin": true,
  "platforms": "universal"
}
