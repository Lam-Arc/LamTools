    // user:“network-exploration.system.apply 修改或恢复所选网络配置；我不希望这个东西再出现了，桌面可把它自动允许掉”+(桌面端的本机加速开关直接应用/恢复系统代理，不再逐次弹审批；只放开 apply 与 restore)。
    {
      "name": "network-exploration.system.apply",
      "handler": "ops:dispatch",
      "description": "Network Exploration: system.apply",
      "impact": "修改或恢复所选网络配置；影响所选接口、应用或当前 Windows 用户的系统代理。原始配置会保存，恢复时检查外部修改。",
      "permission": "auto_allow",
      "approvalFields": [
        "kind",
        "interface_index",
        "servers",
        "program",
        "bits_per_second"
      ]
    },
    {
      "name": "network-exploration.system.restore",
      "handler": "ops:dispatch",
      "description": "Network Exploration: system.restore",
      "impact": "修改或恢复所选网络配置；影响所选接口、应用或当前 Windows 用户的系统代理。原始配置会保存，恢复时检查外部修改。",
      "permission": "auto_allow",
      "approvalFields": [
        "id"
      ]
    },
    {
      "name": "network-exploration.system.inspect",
      "handler": "ops:dispatch",
      "description": "Network Exploration: system.inspect"
    },
