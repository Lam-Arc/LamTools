{
  "tools": [
    {
      "name": "get_knowledge_net",
      "description": "Read a scoped bounded knowledge layer. Default page 20, maximum 50; serialized responses are capped at 32 KiB.",
      "input_schema": {
        "type": "object",
        "properties": {
          "course_id": {
            "type": "string"
          },
          "module_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "include_details": {
            "type": "boolean"
          },
          "relation": {
            "type": "string",
            "enum": [
              "all",
              "prerequisite",
              "next",
              "related"
            ]
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": []
      },
      "permission": "auto_allow",
      "handler": "lamtools_core.plugins.bundled.study.backend:manifest_tool"
    },
    {
      "name": "build_knowledge_net",
      "description": "Atomically update scoped knowledge at the current structure revision. Load the build-map skill before the first knowledge-build batch. Each batch accepts 1–100 operations and is capped at 128 KiB. request_id makes retries idempotent. contains and prerequisite are independently acyclic; related may cycle. Use sign for assessment state.",
      "input_schema": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer"
          },
          "request_id": {
            "type": "string"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "create",
                    "update",
                    "delete",
                    "restore",
                    "merge"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "course",
                    "module",
                    "node",
                    "relation"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "target_id": {
                  "type": "string"
                },
                "confirm_history": {
                  "type": "boolean"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "course_id": {
                      "type": "string"
                    },
                    "parent_id": {
                      "type": "string"
                    },
                    "course_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "module_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "source": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    },
                    "sense": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "notes": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "notes_by_course": {
                      "type": "object"
                    },
                    "content": {
                      "type": "object"
                    },
                    "metadata": {
                      "type": "object"
                    }
                  },
                  "required": []
                }
              },
              "required": [
                "action",
                "kind"
              ]
            }
          }
        },
        "required": [
          "revision",
          "operations"
        ]
      },
      "permission": "auto_allow",
      "handler": "lamtools_core.plugins.bundled.study.backend:manifest_tool"
    },
    {
      "name": "sign",
      "description": "Write evaluated/passed/mastery only from a graded exam suggestion. Requires exam_id, the current grading_version, and exact supporting question_ids. Retries are idempotent; review replaces current evidence while retaining history.",
      "input_schema": {
        "type": "object",
        "properties": {
          "exam_id": {
            "type": "string"
          },
          "grading_version": {
            "type": "integer"
          },
          "updates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "node_id": {
                  "type": "string"
                },
                "passed": {
                  "type": "boolean"
                },
                "mastery": {
                  "type": ["string", "null"],
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "question_ids": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "required": [
                "node_id",
                "passed",
                "mastery",
                "reason",
                "question_ids"
              ]
            }
          }
        },
        "required": [
          "exam_id",
          "grading_version",
          "updates"
        ]
      },
      "permission": "auto_allow",
      "handler": "lamtools_core.plugins.bundled.study.backend:manifest_tool"
    },
    {
      "name": "notes",
      "description": "Read immutable Raw evidence, create versioned AI Resources, and maintain the Markdown Note vault. Load curate-notes first. Every Note cites Resource ids. Updates replace the complete editable body and require both revision and content-hash CAS; user-locked ranges reject overlapping Agent edits.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["raw_list", "raw_get", "resource_list", "resource_get", "resource_create", "resource_update", "list", "tree", "get", "graph", "backlinks", "create", "update"]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "q": {
            "type": "string",
            "description": "Case-insensitive full-content filter across Note titles and Markdown bodies."
          },
          "query": {
            "type": "string",
            "description": "Alias of q for callers that use the search operation spelling."
          },
          "note_id": {
            "type": "string"
          },
          "raw_id": {"type": "string"},
          "resource_id": {"type": "string"},
          "raw_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "resource_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "path": {"type": "string"},
          "parent_id": {"type": ["string", "null"]},
          "body_md": {"type": "string"},
          "expected_content_hash": {"type": "string"},
          "title": {
            "type": "string"
          },
          "revision": {"type": "integer", "minimum": 1},
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "string"
          }
        },
        "required": ["action"]
      },
      "permission": "auto_allow",
      "handler": "lamtools_core.plugins.bundled.study.backend:manifest_tool"
    },
    {
      "name": "exam",
      "description": "Create a complete exam with durable reference answers, per-question points and rubrics; save answer drafts; explicitly submit; record per-question help; retrieve references only when the current Agent needs to recover grading context; then record the Agent's whole-paper grade/review. create requires complete questions including answer, rubric and max_score. get/list never return references; reference does. grade/review accept per-question scores and feedback from the current Agent. The host validates structure, score bounds, versions and evidence ownership, but does not compare learner text with an answer string. save_answers does not submit. uncertain results are not wrong; helped questions are excluded from independent mastery evidence.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "get",
              "reference",
              "list",
              "save_answers",
              "submit",
              "help",
              "grade",
              "review"
            ]
          },
          "exam_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "expected_grading_version": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "scope": {
            "type": "string"
          },
          "question_id": {"type": "string"},
          "level": {"type": "string", "enum": ["hint", "strategy", "solution"]},
          "disclosure": {"type": "string"},
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "choice",
                    "written"
                  ]
                },
                "prompt": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "node_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "answer": {
                  "type": "string"
                },
                "rubric": {
                  "type": "string"
                },
                "max_score": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                }
              },
              "required": [
                "type",
                "prompt",
                "node_ids",
                "answer",
                "rubric",
                "max_score"
              ]
            }
          },
          "answers": {
            "type": ["string", "object"]
          },
          "uncertain": {
            "type": "object"
          },
          "image_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question_id": {"type": "string"},
                "state": {
                  "type": "string",
                  "enum": ["correct", "partial", "incorrect", "uncertain"]
                },
                "score": {"type": ["number", "null"]},
                "reason": {"type": "string"},
                "step_scores": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "criterion": {"type": "string"},
                      "score": {"type": "number"},
                      "max_score": {"type": "number"},
                      "feedback": {"type": "string"}
                    },
                    "required": ["criterion", "score", "max_score"]
                  }
                },
                "assessed_node_ids": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "incorrect_node_ids": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "required": ["question_id", "state", "score", "reason", "assessed_node_ids", "incorrect_node_ids"]
            }
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "node_id": {"type": "string"},
                "passed": {"type": "boolean"},
                "mastery": {"type": ["string", "null"]},
                "reason": {"type": "string"},
                "question_ids": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "required": ["node_id", "passed", "mastery", "reason", "question_ids"]
            }
          }
        },
        "required": [
          "action"
        ]
      },
      "permission": "auto_allow",
      "handler": "lamtools_core.plugins.bundled.study.backend:manifest_tool"
    }
  ]
}
