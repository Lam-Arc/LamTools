{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LamCore",
  "version": "0.1.0",
  "identifier": "com.lamtools.core",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npx vite build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LamCore",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../../dist/lamtools-core-backend"]
  }
}