{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sunday",
  "mainBinaryName": "Sunday",
  "version": "0.3.40",
  "identifier": "com.lamtools.sunday",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sunday",
        "width": 1440,
        "height": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* https://47.114.43.99.nip.io wss://47.114.43.99.nip.io tauri:; frame-src http://127.0.0.1:*; img-src 'self' asset: http://127.0.0.1:* https: data: blob:; media-src 'self' blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline' blob: http://127.0.0.1:* http://localhost:*; font-src 'self' data: http://127.0.0.1:* http://localhost:*; script-src 'self' http://127.0.0.1:* http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": [
          ".lam/**",
          "lam_projects/**"
        ]
      },
      "capabilities": [
        {
          "identifier": "default",
          "windows": [
            "main",
            "pet-overlay",
            "ping-overlay",
            "ping-capture",
            "desktop-overlay",
            "tray-panel"
          ],
          "permissions": [
            "core:window:allow-start-dragging",
            "core:event:default"
          ]
        },
        {
          "identifier": "ping-card",
          "windows": [
            "ping-card-*"
          ],
          "permissions": [
            "core:window:allow-start-dragging",
            "core:event:default",
            "core:window:allow-set-always-on-top"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../../dist/SundayCore": "sunday-backend"
    }
  }
}
