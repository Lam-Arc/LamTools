{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LamCore",
  "version": "0.2.6",
  "identifier": "com.lamtools.lamcore",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LamCore",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-tabs"
      },
      {
        "label": "desktop-plugin-host",
        "create": true,
        "url": "desktop-plugin-host.html",
        "title": "LamTools Desktop Plugin",
        "width": 256,
        "height": 288,
        "minWidth": 96,
        "minHeight": 96,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-tabs"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* tauri:; frame-src http://127.0.0.1:*; img-src 'self' asset: http://127.0.0.1:* data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [".lam/**", "lam_projects/**"]
      },
      "capabilities": [
        {
          "identifier": "default",
          "windows": ["main"],
          "permissions": [
            "core:window:allow-start-dragging",
            "core:event:default"
          ]
        },
        {
          "identifier": "desktop-plugins",
          "description": "Allows the local desktop plugin host to call LamCore host commands.",
          "local": true,
          "windows": ["desktop-plugin-*"],
          "permissions": []
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["lamcore-backend"],
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
