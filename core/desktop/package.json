{
  "name": "lamtools-core-desktop",
  "private": true,
  "version": "0.3.39",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "build:app": "tauri build --no-bundle",
    "package:linux": "bash ../../scripts/package-linux.sh",
    "package:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/package.ps1",
    "tauri": "tauri",
    "pretauri": "node scripts/prepare-network-controller.mjs",
    "pet:dev": "node scripts/pet-dev.mjs",
    "pet:verify": "npm --prefix ../ui run pet:test",
    "dev:pet": "vite --host 127.0.0.1 --port 5299 --strictPort",
    "pet:e2e": "node scripts/pet-e2e.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.41.0",
    "@vue-flow/minimap": "^1.5.2",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5",
    "webdriverio": "^9.32.0"
  }
}
