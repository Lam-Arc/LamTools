{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LamTools Core",
  "version": "0.1.0",
  "identifier": "com.lamtools.core",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist-core-app"
  },
  "app": {
    "windows": [
      {
        "title": "LamTools Core",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../ui/public/app-icon.ico"],
    "resources": ["../../dist/lamtools-core-backend"]
  }
}