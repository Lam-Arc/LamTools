{
  "id": "xfyun-coding-plan",
  "label": "Xfyun Coding Plan",
  "protocol": "openai-chat-completions",
  "match_base_url": [
    "maas-coding-api",
    "xf-yun\\.com",
    "xfyun\\.cn"
  ],
  "request": {
    "thinking": {
      "when_enabled": {
        "enable_thinking": true
      }
    },
    "unsupported_fields": [
      "thinking",
      "reasoning_effort"
    ]
  },
  "stream_response": {
    "content_delta": "choices.0.delta.content",
    "reasoning_delta": "choices.0.delta.reasoning_content",
    "tool_calls_delta": "choices.0.delta.tool_calls",
    "finish_reason": "choices.0.finish_reason",
    "usage": "usage"
  },
  "non_stream_response": {
    "content": "choices.0.message.content",
    "reasoning": "choices.0.message.reasoning_content",
    "tool_calls": "choices.0.message.tool_calls",
    "finish_reason": "choices.0.finish_reason",
    "usage": "usage"
  }
}
