        {
          "thread_id": "th",
          "method": "turn/started",
          "seq": 12,
          "event_id": "ev-start",
          "payload": {
            "turn_id": "turn-2"
          }
        },
        {
          "thread_id": "th",
          "method": "item/tool_prepared",
          "seq": 13,
          "event_id": "ev-prepare",
          "payload": {
            "turn_id": "turn-2",
            "tool_call_id": "call-2",
            "name": "write_file",
            "arguments": {
              "path": "refuse.txt",
              "content": "x"
            }
          }
        },
        {
          "thread_id": "th",
          "method": "item/failed",
          "seq": 14,
          "event_id": "ev-fail",
          "payload": {
            "turn_id": "turn-2",
            "tool_call_id": "call-2",
            "error": "the user denied this call"
          }
        }
      ],
      "expect": [
        {
          "seq": 12,
          "payload": {
            "kind": "status",
            "turn_id": "turn-2",
            "status": "running",
            "item_id": "th:turn-2:status",
            "payload": {
              "type": "status",
              "status": "running"
            }
          }
        },
        {
          "seq": 13,
          "payload": {
            "kind": "tool_call",
            "turn_id": "turn-2",
            "status": "waiting",
            "item_id": "th:turn-2:call-2:tool",
            "payload": {
              "type": "dynamicToolCall",
              "tool_name": "write_file",
              "arguments": {
                "path": "refuse.txt",
                "content": "x"
              }
            }
          }
        },
        {
          "seq": 14,
          "payload": {
            "kind": "tool_result",
            "status": "failed",
            "item_id": "th:turn-2:call-2:tool",
            "payload": {
              "type": "dynamicToolCall",
              "tool_name": "write_file",
              "replace": true,
              "status": "failed",
              "error": "the user denied this call"
            }
          }
        }
      ]
    },
    {
      "name": "the same fact replayed keeps one identity",
      "why": "the client dedupes on event_id; a random id per replay shows the same message twice after a resume",
      "given": [
        {
          "thread_id": "th",
          "method": "turn/model_completed",
          "seq": 15,
          "event_id": "ev-replay",
          "payload": {
            "turn_id": "turn-1",
            "text": "Same text.",
            "round": 0
          }
        },
        {
          "thread_id": "th",
          "method": "turn/model_completed",
          "seq": 15,
          "event_id": "ev-replay",
          "payload": {
            "turn_id": "turn-1",
            "text": "Same text.",
            "round": 0
          }
        }
      ],
      "expect": [
        {
          "seq": 15,
          "event_id": "ev-replay",
          "payload": {
            "kind": "message",
            "item_id": "th:turn-1:assistant:0"
          }
        },
        {
          "seq": 15,
          "event_id": "ev-replay",
          "payload": {
            "kind": "message",
            "item_id": "th:turn-1:assistant:0"
          }
        }
      ]
    },
