            "turn_id": "",
            "item_id": "th::call-b:tool",
            "payload": {
              "request_id": "req-b"
            }
          }
        }
      ]
    },
    {
      "name": "an event with no rendered meaning produces nothing",
      "why": "the journal vocabulary is append-only; a host that invents a card for an unknown method will break on the next core release",
