  "cards": [
    {
      "dot": "cyan",
      "title": "状态所有权图",
      "items": [
        "***核心循环内核***驱动状态转移，***运行时状态存储***是领域侧存储端口。",
        "界面与 SQLite 都不是执行状态的真实状态源。"
      ]
    },
    {
      "dot": "violet",
      "title": "事实与投影",
      "items": [
        "***事件存储***保存运行事实；***快照存储***保存可快速读取的物化状态。",
        "检查点描述可恢复边界，不等同于完整会话历史。"
      ]
    },
    {
      "dot": "rose",
      "title": "风险与建议",
      "items": [
        "核心应用数据库、持久化宿主与核心会话存储仍在应用层交汇。",
        "继续保持运行时 → 端口 → 适配器 → SQLite 的依赖方向，隔离恢复编排。"
      ]
    }
  ]
