  "cards": [
    {
      "dot": "cyan",
      "title": "表示边界",
      "items": [
        "Vue 界面只拥有交互与投影状态，不拥有核心执行状态。",
        "应用服务器客户端负责协议适配与 WebSocket 重连。"
      ]
    },
    {
      "dot": "violet",
      "title": "传输边界",
      "items": [
        "FastAPI 与实时 WebSocket 路由器是可替换的入口适配器。",
        "运行时通过事件中心反向广播，避免界面直接进入核心内核。"
      ]
    },
    {
      "dot": "rose",
      "title": "解耦信号",
      "items": [
        "Tauri 目前承担启动、API 地址注入和桌面宿主能力。",
        "稳定的 API / 实时协议是桌面端与 Web 界面解耦的关键。"
      ]
    }
  ]
