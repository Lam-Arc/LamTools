{
  "name": "@lamtools/mobile",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "android": "cap run android",
    "ios": "cap run ios",
    "tauri": "tauri",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-tauri-android-icons.ps1 && tauri android build --apk"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/network": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.4",
    "@tauri-apps/api": "^2.11.0",
    "b4a": "^1.7.4",
    "jszip": "^3.10.2",
    "lucide-vue-next": "^1.0.0",
    "noise-handshake": "^4.2.0",
    "sodium-javascript": "^0.8.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@tauri-apps/cli": "^2.11.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5",
    "ws": "^8.21.3"
  }
}
