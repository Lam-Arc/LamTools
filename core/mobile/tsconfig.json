{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@lamtools/ui": ["../ui/src/index.ts"],
      "@lamtools/ui/*": ["../ui/src/*"],
      "@lamtools/bundled-workflow-ui": ["../src/lamtools_core/plugins/bundled/workflow/ui/index.ts"],
      "vue": ["../ui/node_modules/vue"],
      "lucide-vue-next": ["../ui/node_modules/lucide-vue-next"],
      "@vue-flow/core": ["../ui/node_modules/@vue-flow/core"],
      "@vue-flow/background": ["../ui/node_modules/@vue-flow/background"],
      "@vue-flow/controls": ["../ui/node_modules/@vue-flow/controls"],
      "@vue-flow/minimap": ["../ui/node_modules/@vue-flow/minimap"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "capacitor.config.ts"]
}
