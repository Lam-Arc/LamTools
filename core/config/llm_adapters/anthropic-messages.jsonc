{
  "id": "anthropic-messages",
  "label": "Anthropic Messages",
  "protocol": "anthropic-messages",
  "auth": "bearer",
  "request": {
    "omit_sampling_when_reasoning": true,
    "reasoning": {
      "cleanup": [
        "thinking",
        "output_config.effort",
        "reasoning_effort",
        "reasoning"
      ],
      "presets": {
        "off": {},
        "light": {
          "set": {
            "thinking": {
              "type": "enabled",
              "budget_tokens": "$thinking_budget_light"
            }
          }
        },
        "medium": {
          "set": {
            "thinking": {
              "type": "enabled",
              "budget_tokens": "$thinking_budget_high"
            }
          }
        },
        "high": {
          "set": {
            "thinking": {
              "type": "enabled",
              "budget_tokens": "$thinking_budget_high"
            }
          }
        },
        "xhigh": {
          "set": {
            "thinking": {
              "type": "enabled",
              "budget_tokens": "$thinking_budget_max"
            }
          }
        },
        "max": {
          "set": {
            "thinking": {
              "type": "enabled",
              "budget_tokens": "$thinking_budget_max"
            }
          }
        }
      }
    }
  },
  "non_stream_response": {
    "content_blocks": "content",
    "usage": "usage"
  }
}
