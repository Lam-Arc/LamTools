{
  "id": "openai-responses",
  "label": "OpenAI Responses",
  "protocol": "openai-responses",
  "reasoning": {
      "levels": [
        { "id": "max", "label": "高" },
        { "id": "medium", "label": "中" },
        { "id": "light", "label": "轻" },
        { "id": "off", "label": "关闭" }
      ]
  },
  "endpoint": "/responses",
  "request": {
    "reasoning": {
      "cleanup": [
        "reasoning",
        "reasoning_effort",
        "thinking",
        "enable_thinking"
      ],
      "presets": {
        "off": {},
        "light": { "set": { "reasoning.effort": "low" } },
        "medium": { "set": { "reasoning.effort": "medium" } },
        "high": { "set": { "reasoning.effort": "medium" } },
        "xhigh": { "set": { "reasoning.effort": "high" } },
        "max": { "set": { "reasoning.effort": "high" } }
      }
    }
  }
}
