{
  "id": "openai-chat",
  "label": "OpenAI Chat Completions compatible",
  "protocol": "openai-chat-completions",
  "reasoning": {
      "levels": [
        { "id": "max", "label": "高" },
        { "id": "medium", "label": "中" },
        { "id": "light", "label": "轻" },
        { "id": "off", "label": "关闭" }
      ]
  },
  "match_model": ["gpt-5", "gpt-4", "o1", "o3", "o4", "o5", "codex-"],
  "request": {
    "reasoning": {
      "cleanup": [
        "reasoning_effort",
        "reasoning",
        "thinking",
        "enable_thinking",
        "thinking_budget"
      ],
      "presets": {
        "off": {},
        "light": {
          "set": { "reasoning_effort": "low" }
        },
        "medium": {
          "set": { "reasoning_effort": "medium" }
        },
        "high": {
          "set": { "reasoning_effort": "medium" }
        },
        "xhigh": {
          "set": { "reasoning_effort": "high" }
        },
        "max": {
          "set": { "reasoning_effort": "high" }
        }
      }
    }
  },
  "stream_response": {
    "content_delta": "choices.0.delta.content",
    "reasoning_delta": "choices.0.delta.reasoning_content",
    "tool_calls_delta": "choices.0.delta.tool_calls",
    "finish_reason": "choices.0.finish_reason",
    "usage": "usage"
  },
  "non_stream_response": {
    "content": "choices.0.message.content",
    "reasoning": "choices.0.message.reasoning_content",
    "tool_calls": "choices.0.message.tool_calls",
    "finish_reason": "choices.0.finish_reason",
    "usage": "usage"
  }
}
