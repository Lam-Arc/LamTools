{
  "id": "anthropic-always-on",
  "label": "Anthropic Always-on Thinking",
  "protocol": "anthropic-messages",
  "match_model": ["claude-opus-5-thinking"],
  "reasoning": {
    "off_supported": false
  },
  "endpoint": "/v1/messages",
  "request": {
    "omit_sampling_always": true,
    "reasoning": {
      "cleanup": ["thinking", "output_config.effort", "reasoning_effort", "reasoning"],
      "presets": {
        "off": {},
        "light": {
          "set": {
            "thinking": { "type": "adaptive" },
            "output_config.effort": "low"
          }
        },
        "medium": {
          "set": {
            "thinking": { "type": "adaptive" },
            "output_config.effort": "high"
          }
        },
        "high": {
          "set": {
            "thinking": { "type": "adaptive" },
            "output_config.effort": "high"
          }
        },
        "xhigh": {
          "set": {
            "thinking": { "type": "adaptive" },
            "output_config.effort": "max"
          }
        },
        "max": {
          "set": {
            "thinking": { "type": "adaptive" },
            "output_config.effort": "max"
          }
        }
      }
    }
  }
}
