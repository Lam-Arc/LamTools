{
  "id": "grok",
  "label": "Grok Reasoning",
  "protocol": "openai-chat-completions",
  "reasoning": {
      "levels": [
        { "id": "max", "label": "高" },
        { "id": "medium", "label": "中" },
        { "id": "light", "label": "轻" },
        { "id": "off", "label": "关闭" }
      ]
  },
  "match_model": ["grok", "xai"],
  "request": {
    "reasoning": {
      "cleanup": ["reasoning_effort", "reasoning", "thinking"],
      "presets": {
        "off": {},
        "light": { "set": { "reasoning_effort": "low" } },
        "medium": { "set": { "reasoning_effort": "medium" } },
        "high": { "set": { "reasoning_effort": "medium" } },
        "xhigh": { "set": { "reasoning_effort": "high" } },
        "max": { "set": { "reasoning_effort": "high" } }
      }
    }
  }
}
