{
  "id": "deepseek-chat",
  "label": "DeepSeek Thinking",
  "protocol": "openai-chat-completions",
  "match_model": ["deepseek"],
  "request": {
    "reasoning": {
      "cleanup": [
        "thinking",
        "reasoning_effort",
        "enable_thinking"
      ],
      "presets": {
        "off": {
          "set": { "thinking.type": "disabled" }
        },
        "light": {
          "set": {
            "thinking.type": "enabled",
            "reasoning_effort": "low"
          }
        },
        "high": {
          "set": {
            "thinking.type": "enabled",
            "reasoning_effort": "high"
          }
        },
        "max": {
          "set": {
            "thinking.type": "enabled",
            "reasoning_effort": "max"
          }
        }
      }
    }
  }
}
