{
  "type": "object",
  "properties": {
    "autoRoots": {
      "type": "array",
      "items": { "type": "string" },
      "default": [".lam/docs"],
      "description": "自动检测并向量化的目录白名单（工作区相对路径；缺省 = 工作区 .lam/docs，会话启动增量扫描仅限这些目录）"
    },
    "indexDir": {
      "type": "string",
      "description": "索引库目录（缺省 {work_root}/.lamtools/rag-index）"
    },
    "embeddingSource": {
      "type": "string",
      "enum": ["local", "api", "none"],
      "default": "local",
      "description": "embedding 来源：local=fastembed(bge-small-zh)；api=provider /embeddings（P3）；none=仅 BM25"
    },
    "vlmModel": {
      "type": "string",
      "description": "VLM 页面图理解模型（P3；缺省复用 default_multimodal_model）"
    }
  }
}
