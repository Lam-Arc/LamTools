{
  "tools": [
    {
      "name": "qqbot_send_file",
      "description": "把本地文件（图片/视频/语音/普通文件）发送到当前 QQ 私聊或群聊。传磁盘上已存在的绝对路径；省略 target 时自动发回当前会话。",
      "input_schema": {
        "type": "object",
        "properties": {
          "file_path": {
            "type": "string",
            "description": "要发送的本地文件绝对路径。"
          },
          "target": {
            "type": "string",
            "description": "可选发送目标：c2c:openid 或 group:openid；省略则发回当前会话。"
          }
        },
        "required": ["file_path"],
        "additionalProperties": false
      },
      "permission": "ask_user",
      "handler": "tools:send_file"
    },
    {
      "name": "qqbot_status",
      "description": "QQ 机器人的运行状态：是否已绑定、网关是否在线、当前有多少会话、模型和访问控制摘要。",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "permission": "auto_allow",
      "handler": "tools:status"
    },
    {
      "name": "qqbot_bind_start",
      "description": "开始 QQ 机器人扫码绑定，返回二维码 SVG（data URL）和绑定链接。用户用手机 QQ 扫码后，凭据会自动保存。",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "permission": "ask_user",
      "visibility": "on_load",
      "skill": "qq-bot",
      "handler": "tools:bind_start"
    }
  ]
}
