{
  "operations": [
    {
      "name": "qqbot.bots.list",
      "description": "列出机器人；可传 sessionId 只看绑定到该 Sunday 会话的机器人",
      "handler": "ops:bots_list"
    },
    {
      "name": "qqbot.bot.create",
      "description": "为指定 Sunday 会话创建一个独立 QQ 机器人（独立 AppID/Secret/网关）",
      "handler": "ops:bot_create"
    },
    {
      "name": "qqbot.bot.delete",
      "description": "停止并移除指定机器人（botId）",
      "handler": "ops:bot_delete"
    },
    {
      "name": "qqbot.bot.state",
      "description": "读取指定机器人（botId）的绑定、网关和目标会话状态",
      "handler": "ops:bot_state"
    },
    {
      "name": "qqbot.status",
      "description": "QQ 机器人状态：绑定、网关、会话数、配置摘要（可选 botId）",
      "handler": "ops:status"
    },
    {
      "name": "qqbot.bind.state",
      "description": "读取扫码绑定状态（starting / waiting / saving / failed / bound）",
      "handler": "ops:bind_state"
    },
    {
      "name": "qqbot.bind.refresh",
      "description": "废弃当前二维码并重新生成",
      "handler": "ops:bind_refresh"
    },
    {
      "name": "qqbot.bind.manual",
      "description": "手动保存 AppID / AppSecret",
      "handler": "ops:bind_manual"
    },
    {
      "name": "qqbot.bind.unbind",
      "description": "解绑并清除已保存凭据",
      "handler": "ops:bind_unbind"
    },
    {
      "name": "qqbot.config.get",
      "description": "读取当前配置（appSecret 不回传）",
      "handler": "ops:config_get"
    },
    {
      "name": "qqbot.config.update",
      "description": "更新配置（只接受 schema 中的字段）",
      "handler": "ops:config_update"
    },
    {
      "name": "qqbot.session.list",
      "description": "列出当前内存中的 QQ 会话",
      "handler": "ops:session_list"
    },
    {
      "name": "qqbot.targets",
      "description": "列出可注入的项目和 Sunday 会话",
      "handler": "ops:targets"
    },
    {
      "name": "qqbot.session.send_file",
      "description": "向指定 QQ 私聊/群聊发送一个本地文件",
      "handler": "ops:session_send_file"
    },
    {
      "name": "qqbot.session.reset",
      "description": "为指定私聊/群聊开启新会话",
      "handler": "ops:session_reset"
    },
    {
      "name": "qqbot.session.stop",
      "description": "中止指定会话正在进行的生成",
      "handler": "ops:session_stop"
    },
    {
      "name": "qqbot.models.list",
      "description": "列出宿主可用模型",
      "handler": "ops:models_list"
    },
    {
      "name": "qqbot.bubbles.preview",
      "description": "预览一段文本在当前气泡规则下会被拆成哪些消息（不发送）",
      "handler": "ops:bubbles_preview"
    },
    {
      "name": "qqbot.test.send",
      "description": "向指定私聊/群聊发送一条测试消息",
      "handler": "ops:test_send"
    },
    {
      "name": "qqbot.gateway.restart",
      "description": "重启 QQ 网关（配置或凭据变更后）",
      "handler": "ops:gateway_restart"
    },
    {
      "name": "qqbot.diagnose",
      "description": "诊断信息：绑定、网关、最近日志、配置（脱敏）",
      "handler": "ops:diagnose"
    },
    {
      "name": "qqbot.logs.tail",
      "description": "读取插件日志尾部",
      "handler": "ops:logs_tail"
    }
  ]
}
