{
  "name": "bili-scroll",
  "version": "0.3.1",
  "description": "每天替你刷一轮 B站：搜视频、读字幕判价值、写日报；复刻自 dsh-bili-scroll（MIT）",
  "scope": "global",
  "defaultEnabled": true,
  "skills": [
    "./skills"
  ],
  "operations": [
    "./operations.jsonc"
  ],
  "commands": [
    {
      "name": "bili-duty",
      "title": "刷B站：取今日值班参数",
      "description": "返回今天的关键词、挑选限额、判重状态与日报位置，开始一轮值班",
      "operation": "bili-scroll.duty.brief"
    }
  ],
  "config": {
    "schema": "./config/schema.jsonc"
  },
  "dependencies": [
    "httpx"
  ],
  "profiles": {
    "duty": {
      "title": "值班轮",
      "tools": [
        "mcp__bilibili__brief",
        "mcp__bilibili__search",
        "mcp__bilibili__video_info",
        "mcp__bilibili__subtitles",
        "mcp__bilibili__comments",
        "mcp__bilibili__save_report",
        "mcp__bilibili__dedup",
        "mcp__bilibili__post_comment",
        "mcp__bilibili__account_status",
        "mcp__bilibili__send_dm",
        "mcp__bilibili__dm_inbox",
        "mcp__bilibili__transcribe"
      ],
      "approval": "auto",
      "modelScene": "background",
      "mcpServers": [
        "bilibili"
      ],
      "budget": {
        "maxToolCalls": 120,
        "maxTokens": 150000
      }
    }
  },
  "mcp": [
    "./mcp/mcp.json"
  ],
  "backend": "./backend/__init__.py",
  "ui": {
    "regions": [
      {
        "region": "settings",
        "order": 10,
        "blocks": [
          {
            "type": "status",
            "label": "值班状态",
            "value": "峰谷自动刷见配置",
            "state": "idle"
          }
        ],
        "actions": [
          {
            "id": "run-now",
            "title": "现在跑一轮",
            "operation": "bili-scroll.run_now"
          },
          {
            "id": "setup",
            "title": "装依赖",
            "operation": "bili-scroll.setup"
          },
          {
            "id": "check",
            "title": "测一下",
            "operation": "bili-scroll.selfcheck"
          }
        ],
        "entry": "./ui/board.js"
      }
    ]
  }
}
