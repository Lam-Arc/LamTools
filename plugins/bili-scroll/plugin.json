{
  "name": "bili-scroll",
  "version": "2.3.1",
  "description": "刷B站：每天替你刷一轮 B 站 —— 读字幕挑出值得的、写一份日报，值得的就私信或 @ 你。能力来自随包内置的 bilibili-mcp 服务器（MCP 配置照搬原版，未改写为进程内工具）。",
  "scope": "global",
  "defaultEnabled": true,
  "engine": {
    "python": ">=3.10",
    "app": ">=0.3.23"
  },
  "mcp": [
    "./mcp/mcp.json"
  ],
  "skills": [
    "./skills"
  ],
  "tools": [
    "./tools/tools.jsonc"
  ],
  "operations": [
    "./operations.jsonc"
  ],
  "config": {
    "schema": "./config/schema.jsonc"
  },
  "backend": "./backend/__init__.py",
  "profiles": {
    "duty": {
      "title": "刷B站 值班轮",
      "tools": [
        "mcp"
      ],
      "approval": "auto",
      "approvedTools": [
        "mcp__bilibili__bili_reply",
        "mcp__bilibili__bili_send_message"
      ],
      "modelScene": "background",
      "mcpServers": [
        "bilibili"
      ],
      "mcpTools": [
        "mcp__bilibili__bili_check_credential",
        "mcp__bilibili__bili_recommend",
        "mcp__bilibili__bili_search",
        "mcp__bilibili__bili_subtitle",
        "mcp__bilibili__bili_comments",
        "mcp__bilibili__bili_danmaku",
        "mcp__bilibili__bili_video_info",
        "mcp__bilibili__bili_cover",
        "mcp__bilibili__bili_frames",
        "mcp__bilibili__bili_transcribe_start",
        "mcp__bilibili__bili_transcribe_result",
        "mcp__bilibili__bili_transcribe",
        "mcp__bilibili__duty_paths",
        "mcp__bilibili__duty_report_append",
        "mcp__bilibili__duty_seen_append",
        "mcp__bilibili__duty_seen_recent",
        "mcp__bilibili__duty_digest_append",
        "mcp__bilibili__bili_unread_messages",
        "mcp__bilibili__bili_received_replies",
        "mcp__bilibili__bili_received_at_and_likes",
        "mcp__bilibili__bili_send_message",
        "mcp__bilibili__bili_reply"
      ],
      "budget": {
        "maxToolCalls": 120,
        "maxTokens": 2000000
      },
      "skills": [
        "bili-scroll"
      ]
    }
  },
  "ui": {
    "regions": [
      {
        "region": "right",
        "order": 50,
        "entry": "./ui/panel.js",
        "actions": [
          {
            "id": "run",
            "title": "现在跑一轮",
            "operation": "bili-scroll.run_round"
          },
          {
            "id": "setup",
            "title": "装主依赖",
            "operation": "bili-scroll.setup",
            "dangerous": true
          },
          {
            "id": "home",
            "title": "打开它的地盘",
            "operation": "bili-scroll.open_home"
          }
        ]
      }
    ],
    "windows": [
      {
        "id": "wall",
        "title": "刷B站",
        "entry": "./ui/window.html",
        "width": 940,
        "height": 680
      }
    ],
    "pages": [
      {
        "id": "wall",
        "title": "刷B站",
        "entry": "./ui/page.mjs",
        "navigation": true,
        "order": 50
      },
      {
        "id": "watched",
        "title": "刷过的视频",
        "entry": "./ui/watched.mjs",
        "navigation": false,
        "order": 51
      }
    ]
  },
  "repository": "https://github.com/Lam-Arc/Sunday-Plugins"
}
