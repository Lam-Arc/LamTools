# Optional build-time overrides for self-hosted distribution.
VITE_SUNDAY_VERSION=0.3.20
VITE_LINUX_VERSION=0.3.17
VITE_WINDOWS_DOWNLOAD_URL=/downloads/Sunday-latest-x64-setup.exe
# Android 包默认走 GitHub Release 的固定地址（tag android-latest）；要换自有服务时覆盖它。
VITE_ANDROID_DOWNLOAD_URL=https://github.com/Lam-Arc/LamTools/releases/download/android-latest/Sunday-mobile-arm64.apk
VITE_ANDROID_QR_URL=/downloads/android-qr.svg
